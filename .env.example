# Blaze OAuth application
BLAZE_CLIENT_ID=
BLAZE_CLIENT_SECRET=
BLAZE_REDIRECT_URI=http://127.0.0.1:8000/auth/blaze/callback

# Blaze owner channel
BLAZE_CHANNEL_ID=
BLAZE_CHANNEL_SLUG=
BLAZE_BOT_USER_ID=

# Optional emergency token fallback. Prefer completing OAuth instead.
BLAZE_ACCESS_TOKEN=
BLAZE_REFRESH_TOKEN=

# Durable state. Use a pooled TLS Neon PostgreSQL URI in production.
DATABASE_URL=

# FoxBot identity and subscription-control channel
FOXBOT_BLAZE_PROFILE_HANDLE=foxbotai
FOXBOT_BLAZE_USER_ID=
FOXBOT_SUBSCRIPTION_CHANNEL_ID=
FOXBOT_SUBSCRIPTION_CHANNEL_SLUG=foxbotai

# Listener behavior
FOXBOT_BLAZE_AUTO_SEND=false
FOXBOT_MULTI_CHANNEL_LIMIT=25
FOXBOT_MULTI_CHANNEL_POLL_SECONDS=5
# Grace window (seconds) around channel-discovery time for clock skew: a
# message timestamped up to this many seconds before discovery still counts
# as "new" instead of backlog. Keep small -- this is not a replay window.
FOXBOT_DISCOVERY_GRACE_SECONDS=15

# Optional product configuration
FOXBOT_FAQ=
FOXBOT_MODE=pro

# Studio dashboard admin auth (shared Basic Auth -- always required)
STUDIO_ADMIN_USER=
STUDIO_ADMIN_PASSWORD=

# Studio dashboard per-person Blaze login (separate from the bot's own
# OAuth above -- see the "FoxBot Studio Dashboard Login" section in app.py).
# STUDIO_AUTH_MODE: basic|blaze|both. Default "both" keeps Basic Auth working
# alongside Blaze login; only set to "blaze" after verifying the new flow.
STUDIO_AUTH_MODE=both
STUDIO_SESSION_SECRET=
STUDIO_APPROVED_BLAZE_USER_IDS=
STUDIO_DASHBOARD_REDIRECT_URI=http://127.0.0.1:8000/auth/dashboard/callback
